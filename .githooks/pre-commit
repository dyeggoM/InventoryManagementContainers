#!/bin/sh
# Refreshes AI_INVENTORY.md from the staged code, so the document a reviewer reads in the diff
# matches the code in that same commit.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip for one commit:    git commit --no-verify
#
# Without the code-inventory skill the hook warns and lets the commit through — a missing local
# tool must not block work. Set CODE_INVENTORY_HOME when the skill lives somewhere else.
set -e

root=$(git rev-parse --show-toplevel)
inventory=${CODE_INVENTORY_HOME:-$HOME/.hermes/skills/software-development/code-inventory}

if [ ! -f "$inventory/scripts/inventory.py" ]; then
  echo "pre-commit: code-inventory not found at $inventory"
  echo "            skipping the inventory refresh (set CODE_INVENTORY_HOME to enable it)"
  exit 0
fi

# .NET SDKs installed with dotnet-install.sh are not on PATH.
export DOTNET_ROOT="${DOTNET_ROOT:-$HOME/.dotnet}"
export PATH="$DOTNET_ROOT:$PATH"

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -n "$staged" ] || exit 0

touch_js=0
touch_cs=0
for path in $staged; do
  case "$path" in
    *.ts | *.tsx | *.js | *.mjs | *.cjs | *.vue) touch_js=1 ;;
    *.cs) touch_cs=1 ;;
  esac
done

if [ "$touch_js" -eq 0 ] && [ "$touch_cs" -eq 0 ]; then
  exit 0
fi

echo "pre-commit: refreshing the code inventory"

# The index reads the working tree, so unstaged edits end up in the document. Say so rather than
# letting a partially staged commit look like it describes only what it contains.
if [ -n "$(git diff --name-only)" ]; then
  echo "pre-commit: note — the working tree has unstaged changes; the inventory reflects the files,"
  echo "            not just the staged diff."
fi

if [ "$touch_js" -eq 1 ]; then
  python3 "$inventory/scripts/inventory.py" sync --root "$root" --lang js >/dev/null
fi

if [ "$touch_cs" -eq 1 ]; then
  python3 "$inventory/scripts/inventory.py" sync --root "$root/IMCAPI" --lang cs >/dev/null
  python3 "$inventory/scripts/inventory.py" sync --root "$root/Testing" --lang cs >/dev/null
fi

# --no-stamp keeps the header stable: the same code renders byte-identical, so the commit only
# carries the inventory diff the code actually produced.
python3 "$inventory/scripts/ai_inventory.py" --root "$root" --no-stamp --no-json >/dev/null
git add AI_INVENTORY.md

echo "pre-commit: AI_INVENTORY.md updated"

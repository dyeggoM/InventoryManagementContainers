# Copy to .env and adjust for your machine.
# The API's http profile listens on http://0.0.0.0:5173 (every interface) and exposes routes under /api.
# Left commented, the app derives the API URL from the page's own hostname, which is what makes it work
# unchanged when you open the dev server from another machine on the LAN (http://<host-ip>:9000).
# QCLI_API_URL=http://localhost:5173/api

# Testing from another machine: leave QCLI_API_URL unset and open the app at
# http://<this-host-ip>:9000 ; it will call http://<this-host-ip>:5173/api .
